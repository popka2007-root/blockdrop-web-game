{
  "name": "blockdrop-web-game",
  "version": "3.1.0",
  "private": true,
  "description": "Deterministic BlockDrop Web/PWA game with authoritative PvP, AI, and verified replays.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build-web.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:functional && npm run test:e2e:performance",
    "test:e2e:functional": "playwright test --project=chromium-functional --project=firefox --project=galaxy-s25-fe --project=mobile-360x700 --project=mobile-390x844 --project=mobile-landscape-780x360 --project=webkit --project=chromium",
    "test:e2e:performance": "playwright test --project=galaxy-s25-fe-performance --no-deps",
    "verify": "npm run lint && npm run test:coverage && npm run db:verify-backup && npm run test:e2e && npm audit --audit-level=high",
    "health:check": "node scripts/check-health.js",
    "smoke:prod": "node scripts/prod-smoke.js",
    "release:validate": "node scripts/release-validate.js",
    "release:check": "npm run verify && npm run smoke:prod",
    "db:backup": "node scripts/backup-sqlite.js",
    "db:restore": "node scripts/restore-sqlite.js",
    "db:verify-backup": "node scripts/test-backup-restore.js",
    "feature:rollout": "node scripts/feature-rollout.js",
    "soak:100": "node scripts/soak-test.js --ccu 100 --duration 7200",
    "capture:media": "node scripts/capture-media.js",
    "balance:calibrate": "node scripts/calibrate-balance.js",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.8.0",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "better-sqlite3": "^12.9.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  }
}
